<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:orientation="vertical"
    tools:context=".QueueActivity">

    <!--  Currently Serving Card  -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        app:cardElevation="8dp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:gravity="center"
            android:id="@+id/tvNoServing"
            android:visibility="gone"
            android:layout_gravity="center"
            android:padding="24dp"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="wrap_content"
                android:text="Currently No Serving"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge.Emphasized"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:padding="12dp"
            android:id="@+id/currentServing"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginBottom="12dp"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:text="Ticket Number"
                    android:id="@+id/tvTicketNumber"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge.Emphasized"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="match_parent"
                    android:text="Status"
                    android:id="@+id/tvStatus"
                    android:textAlignment="textEnd"
                    android:layout_height="wrap_content"/>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="match_parent"
                        android:text="Position"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:textAlignment="center"
                        android:text="1st"
                        android:id="@+id/tvPosition"
                        android:layout_height="wrap_content"/>
                </LinearLayout>


                <View
                    android:layout_width="2dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_height="32dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="match_parent"
                        android:text="Estimated Wait Time"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:textAlignment="center"
                        android:text="5 minutes"
                        android:id="@+id/tvEwt"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:id="@+id/recyclerView"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/layout_ticket_item"
        android:layout_weight="1"
        android:layout_height="0dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:text="No Tickets Yet."
        android:layout_gravity="center"
        android:visibility="gone"
        android:id="@+id/tvEmpty"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge.Emphasized"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:text="Join Queue"
            android:id="@+id/btnJoin"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:id="@+id/btnGroupStaff"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:text="Call Next"
                android:id="@+id/btnCallNext"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_height="wrap_content"/>
            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:text="Mark as Done"
                android:id="@+id/btnDone"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_height="wrap_content"/>
        </LinearLayout>


    </LinearLayout>
</LinearLayout>